  m_EditorClassIdentifier: Assembly-CSharp::LightShadow.UI.QuestionData
  question: Which sentence is grammatically correct?
  options:
  - She don't like tea.
  - He go to school every day.
  - They are reading a book.
  - I has a pencil.
  correctIndex: 2
  category: 4
  difficulty: 2
  explanation: '"They are reading" agrees with its subject. The others break subject-verb
    agreement.'
