  m_Script: {fileID: 11500000, guid: d2cb65e0913b0784b98ecec4a74e5c1f, type: 3}
  m_Name: Q_His_024
  m_EditorClassIdentifier: Assembly-CSharp::LightShadow.UI.QuestionData
  question: 'The Rosetta Stone helped scholars to read which ancient writing system?'
  options:
  - Egyptian hieroglyphs
  - Roman numerals
  - Chinese characters
  - The Phoenician alphabet
  correctIndex: 0
  category: 2
  difficulty: 2
  explanation: 'The stone carries one text in three scripts: hieroglyphic, Demotic and Greek. Scholars already read Greek, so it became the key to decoding the hieroglyphs.'
  factSource: NEEDS-FACT-CHECK
  questionAr: ساعد حجر رشيد العلماء على قراءة أي نظام كتابة قديم؟
  optionsAr:
  - الهيروغليفية المصرية
  - الأرقام الرومانية
  - الحروف الصينية
  - الأبجدية الفينيقية
  explanationAr: 'يحمل الحجر النص نفسه بثلاثة خطوط: الهيروغليفية والديموطيقية واليونانية. وكان العلماء يقرأون اليونانية بالفعل، فكانت مفتاح فك رموز الهيروغليفية.'
