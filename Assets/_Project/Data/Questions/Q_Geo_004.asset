  m_Script: {fileID: 11500000, guid: d2cb65e0913b0784b98ecec4a74e5c1f, type: 3}
  m_Name: Q_Geo_004
  m_EditorClassIdentifier: Assembly-CSharp::LightShadow.UI.QuestionData
  question: Why do places near the Equator stay almost the same temperature all year,
    while places near the poles have big seasonal changes?
  options:
  - The Equator has more oceans
  - The Sun's angle overhead changes much less near the Equator through the year
  - The poles are farther from the Sun in winter
  - Wind never reaches the poles
  correctIndex: 1
  category: 3
  difficulty: 3
  explanation: Earth's tilt changes the Sun's angle a lot near the poles but only
    a little near the Equator, so the tropics stay warm all year.
  factSource: NEEDS-FACT-CHECK
