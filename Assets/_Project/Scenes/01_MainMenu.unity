--- !u!114 &2028137369
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2028137367}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3fd824f7d50d562429d9a7b0c8578977, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightShadow.Core.LocalizedText
  english: 'You are Nour. The school is dark, the demolition crew comes at dawn,
    and the Shadow hunts in the dark.


    <b>Move</b>  W A S D        <b>Look</b> 
    mouse

    <b>Sprint</b>  hold Left Shift    <b>Crouch</b>  hold Left Ctrl

    <b>Flashlight</b> 
    F            <b>Interact</b>  E

    <b>Answer</b>  1 2 3 4          <b>Objectives</b> 
    Tab    <b>Inventory</b>  I    <b>Pause</b>  Esc


    Answer chalkboard questions
    to charge the <b>Bright Idea Meter</b>. A brighter beam reaches further and keeps
    the dark away. Hold the focused beam on the Shadow long enough and it recoils
    and backs off: hold right mouse, hold Y on a gamepad, or long-press the flashlight
    button on touch. Focus only works while the beam is on, and it drains the battery
    faster. Wrong answers and timeouts dim the beam.


    Lit rooms are safe until
    the gate is powered: the Shadow cannot enter them, and every lit room is a checkpoint.
    The battery is fuel and runs out; batteries are scattered through the school.


    Restore
    <b>three fuse boxes</b>, find the master key in the staff room locker, wire the
    gate console, turn the crank and walk out through the main gate. Knowledge Fragments
    are optional. You have two hits of health: medkits heal, and waking at a checkpoint
    refills it. Being caught costs light and sends you back to the last checkpoint.'
  arabic: "\u0623\u0646\u062A \u0646\u0648\u0631. \u0627\u0644\u0645\u062F\u0631\u0633\u0629
    \u0645\u0638\u0644\u0645\u0629\u060C \u0648\u0641\u0631\u064A\u0642 \u0627\u0644\u0647\u062F\u0645
    \u064A\u0623\u062A\u064A \u0639\u0646\u062F \u0627\u0644\u0641\u062C\u0631\u060C
    \u0648\u0627\u0644\u0638\u0644 \u064A\u0637\u0627\u0631\u062F \u0641\u064A \u0627\u0644\u0639\u062A\u0645\u0629.\n\n\u0627\u0644\u062D\u0631\u0643\u0629:
    W A S D        \u0627\u0644\u0646\u0638\u0631: \u0627\u0644\u0641\u0623\u0631\u0629\n\u0627\u0644\u062C\u0631\u064A:
    \u0627\u0633\u062A\u0645\u0631 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
    Shift \u0627\u0644\u0623\u064A\u0633\u0631    \u0627\u0644\u0627\u0646\u062E\u0641\u0627\u0636:
    Ctrl \u0627\u0644\u0623\u064A\u0633\u0631\n\u0627\u0644\u0645\u0635\u0628\u0627\u062D:
    F            \u0627\u0644\u062A\u0641\u0627\u0639\u0644: E\n\u0627\u0644\u0625\u062C\u0627\u0628\u0629:
    1 2 3 4          \u0627\u0644\u0645\u0647\u0627\u0645: Tab    \u0627\u0644\u062D\u0642\u064A\u0628\u0629:
    I    \u0627\u0644\u0625\u064A\u0642\u0627\u0641: Esc\n\n\u0623\u062C\u0628 \u0639\u0646
    \u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0633\u0628\u0648\u0631\u0629 \u0644\u0634\u062D\u0646
    \u0645\u0624\u0634\u0631 \u0627\u0644\u0641\u0643\u0631\u0629 \u0627\u0644\u0645\u0636\u064A\u0626\u0629.
    \u0627\u0644\u0634\u0639\u0627\u0639 \u0627\u0644\u0623\u0642\u0648\u0649 \u064A\u0635\u0644
    \u0623\u0628\u0639\u062F \u0648\u064A\u0628\u0642\u064A \u0627\u0644\u0639\u062A\u0645\u0629
    \u0628\u0639\u064A\u062F\u0629. \u0623\u0628\u0642\u0650 \u0627\u0644\u0634\u0639\u0627\u0639
    \u0627\u0644\u0645\u0631\u0643\u0651\u0632 \u0639\u0644\u0649 \u0627\u0644\u0638\u0644
    \u0645\u062F\u0629 \u0643\u0627\u0641\u064A\u0629 \u0641\u064A\u0631\u062A\u062F\u0651
    \u0648\u064A\u0628\u062A\u0639\u062F: \u0627\u0636\u063A\u0637 \u0645\u0637\u0648\u0644\u064B\u0627
    \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0641\u0623\u0631\u0629 \u0627\u0644\u0623\u064A\u0645\u0646\u060C
    \u0623\u0648 Y \u0641\u064A \u064A\u062F \u0627\u0644\u062A\u062D\u0643\u0645\u060C
    \u0623\u0648 \u0627\u0636\u063A\u0637 \u0645\u0637\u0648\u0644\u064B\u0627 \u0639\u0644\u0649
    \u0632\u0631 \u0627\u0644\u0645\u0635\u0628\u0627\u062D \u0641\u064A \u0627\u0644\u0644\u0645\u0633.
    \u0627\u0644\u062A\u0631\u0643\u064A\u0632 \u064A\u0639\u0645\u0644 \u0641\u0642\u0637
    \u0648\u0627\u0644\u0634\u0639\u0627\u0639 \u0645\u0636\u0627\u0621\u060C \u0648\u064A\u0633\u062A\u0647\u0644\u0643
    \u0627\u0644\u0628\u0637\u0627\u0631\u064A\u0629 \u0623\u0633\u0631\u0639. \u0627\u0644\u0625\u062C\u0627\u0628\u0627\u062A
    \u0627\u0644\u062E\u0627\u0637\u0626\u0629 \u0648\u0627\u0646\u062A\u0647\u0627\u0621
    \u0627\u0644\u0648\u0642\u062A \u062A\u062E\u0641\u062A \u0627\u0644\u0634\u0639\u0627\u0639.\n\n\u0627\u0644\u063A\u0631\u0641
    \u0627\u0644\u0645\u0636\u0627\u0621\u0629 \u0622\u0645\u0646\u0629 \u062D\u062A\u0649
    \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0628\u0648\u0627\u0628\u0629: \u0644\u0627
    \u064A\u0633\u062A\u0637\u064A\u0639 \u0627\u0644\u0638\u0644 \u062F\u062E\u0648\u0644\u0647\u0627\u060C
    \u0648\u0643\u0644 \u063A\u0631\u0641\u0629 \u0645\u0636\u0627\u0621\u0629 \u0646\u0642\u0637\u0629
    \u062D\u0641\u0638. \u0627\u0644\u0628\u0637\u0627\u0631\u064A\u0629 \u0648\u0642\u0648\u062F
    \u0648\u062A\u0646\u0641\u062F\u061B \u0627\u0644\u0628\u0637\u0627\u0631\u064A\u0627\u062A
    \u0645\u0648\u0632\u0639\u0629 \u0641\u064A \u0627\u0644\u0645\u062F\u0631\u0633\u0629.\n\n\u0623\u0639\u062F
    \u062A\u0634\u063A\u064A\u0644 \u062B\u0644\u0627\u062B\u0629 \u0635\u0646\u0627\u062F\u064A\u0642
    \u0645\u0635\u0627\u0647\u0631\u060C \u062B\u0645 \u062C\u062F \u0627\u0644\u0645\u0641\u062A\u0627\u062D
    \u0627\u0644\u0631\u0626\u064A\u0633\u064A \u0641\u064A \u062E\u0632\u0627\u0646\u0629
    \u063A\u0631\u0641\u0629 \u0627\u0644\u0645\u0639\u0644\u0645\u064A\u0646\u060C
    \u0648\u0648\u0635\u0651\u0644 \u0644\u0648\u062D\u0629 \u0627\u0644\u0642\u0648\u0627\u0637\u0639\u060C
    \u0648\u0623\u062F\u0631 \u0627\u0644\u0645\u0642\u0628\u0636\u060C \u0648\u0627\u062E\u0631\u062C
    \u0645\u0646 \u0627\u0644\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0631\u0626\u064A\u0633\u064A\u0629.
    \u0634\u0630\u0631\u0627\u062A \u0627\u0644\u0645\u0639\u0631\u0641\u0629 \u0627\u062E\u062A\u064A\u0627\u0631\u064A\u0629.
    \u0644\u062F\u064A\u0643 \u0636\u0631\u0628\u062A\u0627\u0646 \u0645\u0646 \u0627\u0644\u0635\u062D\u0629:
    \u0627\u0644\u0625\u0633\u0639\u0627\u0641\u0627\u062A \u062A\u0639\u0627\u0644\u062C\u0643\u060C
    \u0648\u0627\u0644\u0627\u0633\u062A\u064A\u0642\u0627\u0638 \u0639\u0646\u062F
    \u0646\u0642\u0637\u0629 \u062D\u0641\u0638 \u064A\u0639\u064A\u062F\u0647\u0627.
    \u0627\u0644\u0625\u0645\u0633\u0627\u0643 \u0628\u0643 \u064A\u0643\u0644\u0641\u0643
    \u0636\u0648\u0621\u064B\u0627 \u0648\u064A\u0639\u064A\u062F\u0643 \u0625\u0644\u0649
    \u0622\u062E\u0631 \u0646\u0642\u0637\u0629 \u062D\u0641\u0638."
  rightAlignInArabic: 1
  arabicAlignment: 5
