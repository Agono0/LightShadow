  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightShadow.Gameplay.StageLightsPuzzle
  puzzleId: 
  displayNameEn: the stage light rig
  displayNameAr: "\u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u0645\u0633\u0631\u062D"
  hintsEn:
  - Watch the lamps; they flash one color at a time.
  - Repeat the flashes in the same order on the switches.
  - 'Six flashes: red, green, amber, blue, green, red.'
  hintsAr:
  - "\u0631\u0627\u0642\u0628 \u0627\u0644\u0645\u0635\u0627\u0628\u064A\u062D\u061B
    \u062A\u0648\u0645\u0636 \u0644\u0648\u0646\u064B\u0627 \u0648\u0627\u062D\u062F\u064B\u0627
    \u0641\u064A \u0643\u0644 \u0645\u0631\u0629."
  - "\u0643\u0631\u0651\u0631 \u0627\u0644\u0648\u0645\u0636\u0627\u062A \u0628\u0627\u0644\u062A\u0631\u062A\u064A\u0628
    \u0646\u0641\u0633\u0647 \u0639\u0644\u0649 \u0627\u0644\u0645\u0641\u0627\u062A\u064A\u062D."
  - "\u0633\u062A \u0648\u0645\u0636\u0627\u062A: \u0623\u062D\u0645\u0631\u060C
    \u0623\u062E\u0636\u0631\u060C \u0643\u0647\u0631\u0645\u0627\u0646\u060C \u0623\u0632\u0631\u0642\u060C
    \u0623\u062E\u0636\u0631\u060C \u0623\u062D\u0645\u0631."
  config: {fileID: 0}
  colorsEn:
  - Red
  - Amber
  - Green
  - Blue
  colorsAr:
  - "\u0623\u062D\u0645\u0631"
  - "\u0643\u0647\u0631\u0645\u0627\u0646"
  - "\u0623\u062E\u0636\u0631"
  - "\u0623\u0632\u0631\u0642"
