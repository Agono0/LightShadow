  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61a6304ffa4547d1ab2a8b0f48251bc4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightShadow.Gameplay.CatalogueSortPuzzle
  puzzleId: 
  displayNameEn: the card catalogue
  displayNameAr: "\u0641\u0647\u0631\u0633 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062A"
  hintsEn:
  - Every card names a book; every drawer names a kind of book.
  - The Mu'allaqa is a poem, and the Canon will not cure your shelving.
  - Taha Hussein wrote about his own life; al-Tabari wrote about everyone's.
  hintsAr:
  - "\u0643\u0644 \u0628\u0637\u0627\u0642\u0629 \u062A\u0630\u0643\u0631 \u0643\u062A\u0627\u0628\u064B\u0627\u060C
    \u0648\u0643\u0644 \u062F\u0631\u062C \u064A\u0630\u0643\u0631 \u0646\u0648\u0639\u064B\u0627
    \u0645\u0646 \u0627\u0644\u0643\u062A\u0628."
  - "\u0627\u0644\u0645\u0639\u0644\u0642\u0629 \u0642\u0635\u064A\u062F\u0629\u060C
    \u0648\u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0644\u0646 \u064A\u0639\u0627\u0644\u062C
    \u0631\u0641\u0648\u0641\u0643."
  - "\u0637\u0647 \u062D\u0633\u064A\u0646 \u0643\u062A\u0628 \u0639\u0646 \u062D\u064A\u0627\u062A\u0647\u060C
    \u0648\u0627\u0644\u0637\u0628\u0631\u064A \u0643\u062A\u0628 \u0639\u0646 \u062D\u064A\u0627\u0629
    \u0627\u0644\u062C\u0645\u064A\u0639."
  config: {fileID: 0}
  cluesEn:
  - The Mu'allaqa of Imru' al-Qais - "Stop, let us weep"
  - The Days - Taha Hussein's memoir of his village school
  - Al-Tabari's History - prophets, kings and caliphs
  - The Canon of Medicine - Ibn Sina
  cluesAr:
  - "\u0645\u0639\u0644\u0642\u0629 \u0627\u0645\u0631\u0626 \u0627\u0644\u0642\u064A\u0633
    - \xAB\u0642\u0641\u0627 \u0646\u0628\u0643\u0650\xBB"
  - "\u0627\u0644\u0623\u064A\u0627\u0645 - \u0633\u064A\u0631\u0629 \u0637\u0647
    \u062D\u0633\u064A\u0646 \u0639\u0646 \u0645\u062F\u0631\u0633\u0629 \u0642\u0631\u064A\u062A\u0647"
  - "\u062A\u0627\u0631\u064A\u062E \u0627\u0644\u0637\u0628\u0631\u064A - \u0623\u0646\u0628\u064A\u0627\u0621
    \u0648\u0645\u0644\u0648\u0643 \u0648\u062E\u0644\u0641\u0627\u0621"
  - "\u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0641\u064A \u0627\u0644\u0637\u0628
    - \u0627\u0628\u0646 \u0633\u064A\u0646\u0627"
  correctDrawers: 00000000010000000200000003000000
  drawersEn:
  - Poetry
  - Stories
  - History
  - Science
  drawersAr:
  - "\u0627\u0644\u0634\u0639\u0631"
  - "\u0627\u0644\u0642\u0635\u0635"
  - "\u0627\u0644\u062A\u0627\u0631\u064A\u062E"
  - "\u0627\u0644\u0639\u0644\u0648\u0645"
  tray: {fileID: 1109163120}
