  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e4866da3776484b823a4e56f3af5208, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightShadow.Gameplay.GateCircuitPuzzle
  puzzleId: 
  displayNameEn: the gate console
  displayNameAr: "\u0644\u0648\u062D\u0629 \u0627\u0644\u0628\u0648\u0627\u0628\u0629"
  hintsEn:
  - Every feed wants the terminal that matches its strength.
  - The gate motor is the hungriest - give it the main hall feed.
  - The dawn lights sip; the library feed is enough. What is left turns the crank.
  hintsAr:
  - "\u0643\u0644 \u062A\u063A\u0630\u064A\u0629 \u062A\u0631\u064A\u062F \u0627\u0644\u0637\u0631\u0641
    \u0627\u0644\u0630\u064A \u064A\u0646\u0627\u0633\u0628 \u0642\u0648\u062A\u0647\u0627."
  - "\u0645\u062D\u0631\u0643 \u0627\u0644\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0623\u0643\u062B\u0631
    \u062C\u0648\u0639\u064B\u0627 - \u0623\u0639\u0637\u0647 \u062A\u063A\u0630\u064A\u0629
    \u0627\u0644\u0642\u0627\u0639\u0629."
  - "\u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u0641\u062C\u0631 \u062A\u0643\u062A\u0641\u064A
    \u0628\u0627\u0644\u0642\u0644\u064A\u0644\u061B \u062A\u063A\u0630\u064A\u0629
    \u0627\u0644\u0645\u0643\u062A\u0628\u0629 \u062A\u0643\u0641\u064A. \u0648\u0645\u0627
    \u062A\u0628\u0642\u0649 \u064A\u062F\u064A\u0631 \u0627\u0644\u0630\u0631\u0627\u0639."
  config: {fileID: 0}
  feedsEn:
  - Library feed
  - Science feed
  - Main hall feed
  feedsAr:
  - "\u062A\u063A\u0630\u064A\u0629 \u0627\u0644\u0645\u0643\u062A\u0628\u0629"
  - "\u062A\u063A\u0630\u064A\u0629 \u0627\u0644\u0645\u062E\u062A\u0628\u0631"
  - "\u062A\u063A\u0630\u064A\u0629 \u0627\u0644\u0642\u0627\u0639\u0629"
  terminalsEn:
  - Gate motor
  - Dawn lights
  - Gate crank
  terminalsAr:
  - "\u0645\u062D\u0631\u0643 \u0627\u0644\u0628\u0648\u0627\u0628\u0629"
  - "\u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u0641\u062C\u0631"
  - "\u0630\u0631\u0627\u0639 \u0627\u0644\u0628\u0648\u0627\u0628\u0629"
  mapping: 010000000200000000000000
  gate: {fileID: 2040792367}
  masterKeyPuzzleId: Puzzle_MapLocker
  clunkClip: {fileID: 0}
  sparkClip: {fileID: 0}
