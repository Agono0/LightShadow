  m_Script: {fileID: 11500000, guid: 2412de773a4d4bd9b70236db03e3aade, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightShadow.Gameplay.ChalkboardCipherPuzzle
  puzzleId: 
  displayNameEn: the teacher's desk lock
  displayNameAr: "\u0642\u0641\u0644 \u062F\u0631\u062C \u0627\u0644\u0645\u062F\u0631\u0651\u0633\u0629"
  hintsEn:
  - Each chalk line hides exactly one digit.
  - Do each sum, then find the digit that was rubbed away.
  - Read the four missing digits from top to bottom.
  hintsAr:
  - "\u0643\u0644 \u0633\u0637\u0631 \u0639\u0644\u0649 \u0627\u0644\u0633\u0628\u0648\u0631\u0629
    \u064A\u062E\u0641\u064A \u0631\u0642\u0645\u064B\u0627 \u0648\u0627\u062D\u062F\u064B\u0627."
  - "\u0627\u062D\u0633\u0628 \u0643\u0644 \u0639\u0645\u0644\u064A\u0629\u060C \u062B\u0645
    \u0627\u0639\u062B\u0631 \u0639\u0644\u0649 \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0645\u062D\u0648."
  - "\u0627\u0642\u0631\u0623 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u0623\u0631\u0628\u0639\u0629
    \u0627\u0644\u0646\u0627\u0642\u0635\u0629 \u0645\u0646 \u0641\u0648\u0642 \u0625\u0644\u0649
    \u062A\u062D\u062A."
  config: {fileID: 0}
  code: 6371
  sequenceEn: "7 \xD7 8 = 5_\n9 \xD7 4 = _6\n11 \xD7 7 = 7_\n9 \xD7 9 = 8_"
  sequenceAr: "7 \xD7 8 = 5_\n9 \xD7 4 = _6\n11 \xD7 7 = 7_\n9 \xD7 9 = 8_"
  drawer: {fileID: 1673608904}
  rewardRoot: {fileID: 510774190}
  squealClip: {fileID: 0}
  openClip: {fileID: 0}
