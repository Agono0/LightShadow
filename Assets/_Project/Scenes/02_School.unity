--- !u!114 &889046262
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 889046260}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 68ddbc0fc6f14da59d4fb36a54f0bc76, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightShadow.Gameplay.FirstAidOrderPuzzle
  puzzleId: 
  displayNameEn: the first-aid board
  displayNameAr: "\u0644\u0648\u062D\u0629 \u0627\u0644\u0625\u0633\u0639\u0627\u0641\u0627\u062A"
  hintsEn:
  - Clean hands come before everything.
  - Stop the bleeding before you wash the wound.
  - Dress last, then raise the arm and check your work.
  hintsAr:
  - "\u0627\u0644\u064A\u062F\u0627\u0646 \u0627\u0644\u0646\u0638\u064A\u0641\u062A\u0627\u0646
    \u0642\u0628\u0644 \u0643\u0644 \u0634\u064A\u0621."
  - "\u0623\u0648\u0642\u0641 \u0627\u0644\u0646\u0632\u064A\u0641 \u0642\u0628\u0644
    \u063A\u0633\u0644 \u0627\u0644\u062C\u0631\u062D."
  - "\u0627\u0644\u062A\u0636\u0645\u064A\u062F \u0623\u062E\u064A\u0631\u064B\u0627\u060C
    \u062B\u0645 \u0627\u0631\u0641\u0639 \u0627\u0644\u0630\u0631\u0627\u0639 \u0648\u062A\u0641\u0642\u0651\u062F
    \u0639\u0645\u0644\u0643."
  config: {fileID: 0}
  stepsEn:
  - Wash your hands
  - Press on the wound to stop the bleeding
  - Clean the wound with clean water
  - Dress it with a sterile bandage
  - Raise the arm and check the bandage
  stepsAr:
  - "\u0627\u063A\u0633\u0644 \u064A\u062F\u064A\u0643"
  - "\u0627\u0636\u063A\u0637 \u0639\u0644\u0649 \u0627\u0644\u062C\u0631\u062D \u0644\u0625\u064A\u0642\u0627\u0641
    \u0627\u0644\u0646\u0632\u064A\u0641"
  - "\u0646\u0638\u0651\u0641 \u0627\u0644\u062C\u0631\u062D \u0628\u0645\u0627\u0621
    \u0646\u0638\u064A\u0641"
  - "\u0636\u0645\u0651\u062F\u0647 \u0628\u0636\u0645\u0627\u062F\u0629 \u0645\u0639\u0642\u0645\u0629"
  - "\u0627\u0631\u0641\u0639 \u0627\u0644\u0630\u0631\u0627\u0639 \u0648\u062A\u0641\u0642\u0651\u062F
    \u0627\u0644\u0636\u0645\u0627\u062F\u0629"
  displayOrder: 0200000000000000040000000100000003000000
  drawer: {fileID: 744098755}
  rewardRoot: {fileID: 1328458515}
  drawerOpenOffset: {x: 0.55, y: 0, z: 0}
