  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightShadow.Gameplay.OpticsBenchPuzzle
  puzzleId: 
  displayNameEn: the optics bench
  displayNameAr: "\u0645\u0646\u0635\u0629 \u0627\u0644\u0628\u0635\u0631\u064A\u0627\u062A"
  hintsEn:
  - Light bounces off a mirror at the same angle it arrives.
  - The prism bends the beam; it needs the steepest turn of the three.
  - Mirror A turns the beam once, the prism twice, Mirror B three quarter-turns.
  hintsAr:
  - "\u064A\u0631\u062A\u062F \u0627\u0644\u0636\u0648\u0621 \u0639\u0646 \u0627\u0644\u0645\u0631\u0622\u0629
    \u0628\u0646\u0641\u0633 \u0627\u0644\u0632\u0627\u0648\u064A\u0629 \u0627\u0644\u062A\u064A
    \u064A\u0635\u0644 \u0628\u0647\u0627."
  - "\u0627\u0644\u0645\u0646\u0634\u0648\u0631 \u064A\u0643\u0633\u0631 \u0627\u0644\u0634\u0639\u0627\u0639\u061B
    \u064A\u062D\u062A\u0627\u062C \u0623\u0643\u0628\u0631 \u0627\u0646\u0639\u0637\u0627\u0641\u0629
    \u0628\u064A\u0646 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062B\u0644\u0627\u062B\u0629."
  - "\u0627\u0644\u0645\u0631\u0622\u0629 \u0623 \u062A\u062F\u0648\u0631 \u0631\u0628\u0639
    \u062F\u0648\u0631\u0629\u060C \u0648\u0627\u0644\u0645\u0646\u0634\u0648\u0631
    \u0631\u0628\u0639\u064A\u0646\u060C \u0648\u0627\u0644\u0645\u0631\u0622\u0629
    \u0628 \u062B\u0644\u0627\u062B\u0629 \u0623\u0631\u0628\u0627\u0639."
  config: {fileID: 0}
  elementsEn:
  - Mirror A
  - Prism
  - Mirror B
  elementsAr:
  - "\u0627\u0644\u0645\u0631\u0622\u0629 \u0623"
  - "\u0627\u0644\u0645\u0646\u0634\u0648\u0631"
  - "\u0627\u0644\u0645\u0631\u0622\u0629 \u0628"
