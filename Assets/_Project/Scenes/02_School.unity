  m_Script: {fileID: 11500000, guid: e40f7f166610406bbbc4fbc5f0f001a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightShadow.Gameplay.MapLockerPuzzle
  puzzleId: 
  displayNameEn: the middle locker's lock
  displayNameAr: "\u0642\u0641\u0644 \u0627\u0644\u062E\u0632\u0627\u0646\u0629 \u0627\u0644\u0648\u0633\u0637\u0649"
  hintsEn:
  - The map pins carry numbers.
  - The note gives an order of cities; the map turns cities into countries.
  - Cairo, Beirut, Baghdad, Rabat - read the digits in that order.
  hintsAr:
  - "\u062F\u0628\u0627\u0628\u064A\u0633 \u0627\u0644\u062E\u0631\u064A\u0637\u0629
    \u062A\u062D\u0645\u0644 \u0623\u0631\u0642\u0627\u0645\u064B\u0627."
  - "\u0627\u0644\u0645\u0644\u0627\u062D\u0638\u0629 \u062A\u0631\u062A\u0651\u0628
    \u0627\u0644\u0645\u062F\u0646\u061B \u0648\u0627\u0644\u062E\u0631\u064A\u0637\u0629
    \u062A\u062D\u0648\u0651\u0644 \u0627\u0644\u0645\u062F\u0646 \u0625\u0644\u0649
    \u062F\u0648\u0644."
  - "\u0627\u0644\u0642\u0627\u0647\u0631\u0629\u060C \u0628\u064A\u0631\u0648\u062A\u060C
    \u0628\u063A\u062F\u0627\u062F\u060C \u0627\u0644\u0631\u0628\u0627\u0637 - \u0627\u0642\u0631\u0623
    \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0628\u0647\u0630\u0627 \u0627\u0644\u062A\u0631\u062A\u064A\u0628."
  config: {fileID: 0}
  code: 4729
  noteEn: 'Her summer route, the way she always told it:

    Cairo first, then Beirut,
    then Baghdad, then Rabat.'
  noteAr: "\u0637\u0631\u064A\u0642 \u0631\u062D\u0644\u062A\u0647\u0627 \u0627\u0644\u0635\u064A\u0641\u064A\u0629
    \u0643\u0645\u0627 \u0643\u0627\u0646\u062A \u062A\u0631\u0648\u064A\u0647 \u062F\u0627\u0626\u0645\u064B\u0627:\n\u0627\u0644\u0642\u0627\u0647\u0631\u0629
    \u0623\u0648\u0644\u064B\u0627\u060C \u062B\u0645 \u0628\u064A\u0631\u0648\u062A\u060C
    \u062B\u0645 \u0628\u063A\u062F\u0627\u062F\u060C \u062B\u0645 \u0627\u0644\u0631\u0628\u0627\u0637."
  door: {fileID: 1844231191}
  rewardRoot: {fileID: 555472760}
  doorOpenOffset: {x: 0, y: 0, z: 0.75}
  clankClip: {fileID: 0}
  openClip: {fileID: 0}
